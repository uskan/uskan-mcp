{
  "name": "uskan-mcp",
  "version": "0.3.0",
  "description": "MCP server that lets coding agents publish mobile apps to the App Store and Google Play through uskan.app, straight from the project folder.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "uskan-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "app-store",
    "google-play",
    "publish",
    "app-publishing",
    "mobile",
    "ios",
    "android",
    "expo",
    "react-native",
    "flutter",
    "aab",
    "ipa",
    "fastlane",
    "app-store-connect",
    "play-console",
    "claude",
    "claude-code",
    "cursor",
    "codex",
    "windsurf",
    "vibe-coding",
    "uskan"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uskan/uskan-mcp.git"
  },
  "homepage": "https://uskan.app",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "author": "uskan (https://uskan.app)",
  "bugs": {
    "url": "https://github.com/uskan/uskan-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
